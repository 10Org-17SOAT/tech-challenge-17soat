DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tech_challenge

# Generate a real secret, e.g.: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# Base pública da API — usada para montar o link de aprovação do orçamento
APP_BASE_URL=http://localhost:3000

# Email. `log` não envia nada, só escreve a mensagem no logger (padrão em dev e testes).
MAIL_DRIVER=log
MAIL_FROM=oficina@example.com
MAIL_FROM_NAME=Oficina
# Obrigatório apenas quando MAIL_DRIVER=brevo
# BREVO_API_KEY=
