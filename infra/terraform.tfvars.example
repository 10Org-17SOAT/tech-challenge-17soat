# ---------------------------------------------------------------------------
# Valores compartilhados de exemplo — NÃO contém segredos.
# Copie para terraform.tfvars (ignorado pelo Git) e ajuste para sua conta.
# Regra: nunca versionar terraform.tfvars; este .example é seguro e é versionado.
# ---------------------------------------------------------------------------
#
# Uso:
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars


# --- Integração AWS -------------------------------------------------------

aws_region = "us-east-1"

# Guard de conta. DESCUBRA o seu com `aws sts get-caller-identity` e preencha:
#   allowed_account_ids = ["000000000000"]
allowed_account_ids = []

# --- Identidade e ambiente -----------------------------------------------

project_name = "tech-challenge-soat"
environment  = "production"

# --- Kubernetes  ---------------------------------------------------------

k8s_namespace = "tech-challenge-soat"

# --- Rede  ---------------------------------------------------------------

vpc_cidr          = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Subnets privadas do banco (database.tf): duas, uma por AZ, dentro de vpc_cidr
# e sem repetir public_subnet_cidr.
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# availability_zone = "sa-east-1a"

# --- Cálculo -------------------------------------------------------------

instance_type  = "t4g.medium"
root_volume_size = 20
ami_owner      = "099720109477"
ami_name_filter = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-arm64-server-*"

# --- Banco de dados (RDS) -----------------------------------------------

db_engine_version        = "16"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_name                  = "tech_challenge"
db_username              = "postgres"
db_backup_retention_days = 7

# Mude para false, rode apply e só então destroy (README, seção 13).
db_deletion_protection = true
# db_apply_immediately = true

# --- Acesso à VM ---------------------------------------------------------

# OBRIGATÓRIO. Conteúdo da SUA chave pública (não a privada): é a única forma
# de entrar na VM e copiar o kubeconfig. Trocar depois recria a VM. Gere com
# `ssh-keygen -t ed25519` se ainda não tiver.
#   ssh_public_key = "ssh-ed25519 AAAA... voce@maquina"

# --- Operação -------------------------------------------------------------

# k3s_version = "v1.31.5+k3s1"
# domain       = "api.exemplo.com.br"
