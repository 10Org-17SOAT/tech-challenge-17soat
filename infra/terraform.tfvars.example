# ---------------------------------------------------------------------------
# Example shared values — contains NO secrets.
# Copy to terraform.tfvars (ignored by Git) and adjust for your account.
# Rule: never commit terraform.tfvars; this .example is safe and committed.
# ---------------------------------------------------------------------------
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   $EDITOR terraform.tfvars


# --- AWS integration -----------------------------------------------------

aws_region = "us-east-1"

# Account guard. FIND yours with `aws sts get-caller-identity` and fill it in:
#   allowed_account_ids = ["000000000000"]
allowed_account_ids = []

# --- Identity and environment --------------------------------------------

project_name = "tech-challenge-soat"
environment  = "production"

# --- Kubernetes ----------------------------------------------------------

k8s_namespace = "tech-challenge-soat"

# --- Network -------------------------------------------------------------

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Private database subnets (database.tf): two, one per AZ, inside vpc_cidr and
# not reusing public_subnet_cidr.
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# availability_zone = "sa-east-1a"

# --- Compute -------------------------------------------------------------

instance_type    = "t4g.medium"
root_volume_size = 20
ami_owner        = "099720109477"
ami_name_filter  = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-arm64-server-*"

# --- Database (RDS) ------------------------------------------------------

db_engine_version        = "16"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_name                  = "tech_challenge"
db_username              = "postgres"
db_backup_retention_days = 7

# Set to false, run apply and only then destroy (README, section 13).
db_deletion_protection = true
# db_apply_immediately = true

# --- VM access -----------------------------------------------------------

# REQUIRED. Content of YOUR public key (not the private one): it is the only
# way into the VM to copy the kubeconfig. Changing it later recreates the VM.
# Generate one with `ssh-keygen -t ed25519` if you do not have it yet.
#   ssh_public_key = "ssh-ed25519 AAAA... you@machine"

# --- Operations ----------------------------------------------------------

# k3s_version = "v1.31.5+k3s1"
# domain      = "api.example.com"
